# ═══════════════════════════════════════════════════════════════════
#  FP ESTIMATOR — FILE .ENV TỔNG
#  Đặt file này ở THƯ MỤC GỐC của project (cùng cấp với backend/)
#
#  Cấu trúc:
#    Software-Measure/
#    ├── .env                 ← FILE NÀY
#    ├── backend/
#    ├── backend-node/
#    └── frontend/
# ═══════════════════════════════════════════════════════════════════


# ───────────────────────────────────────────────────────────────────
# GEMINI AI  (dùng bởi: backend/)
# Lấy key tại: https://aistudio.google.com/app/apikey
# ───────────────────────────────────────────────────────────────────
GEMINI_API_KEY=AIzaSyApWu6g5kIa5pmTexpTE4Bvr1nCxxPUFkc
GEMINI_MODEL=gemini-2.5-flash


# ───────────────────────────────────────────────────────────────────
# PYTHON FLASK BACKEND  (dùng bởi: backend/ và backend-node/)
# ───────────────────────────────────────────────────────────────────
PORT=5000
DEBUG=false


# ───────────────────────────────────────────────────────────────────
# NODE.JS BACKEND  (dùng bởi: backend-node/)
# ───────────────────────────────────────────────────────────────────
NODE_PORT=3001

# MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD='Duymanh20092005#'
DB_NAME=fp_estimator_db

# JWT — đổi thành chuỗi ngẫu nhiên dài ít nhất 32 ký tự
JWT_SECRET=change_this_to_a_long_random_string_min_32_chars
JWT_EXPIRES_IN=7d

# URL của Python Flask (để Node gọi sang)
PYTHON_API_URL=http://localhost:5000


# ───────────────────────────────────────────────────────────────────
# REACT FRONTEND  (dùng bởi: frontend/)
# Các biến VITE_ được Vite inject vào browser khi build
# ───────────────────────────────────────────────────────────────────
VITE_API_URL=http://localhost:5000
VITE_NODE_API_URL=http://localhost:3001
